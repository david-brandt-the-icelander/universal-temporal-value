        {
          "path": "implementations/typescript/src/context.ts",
          "symbol": "TemporalContext.with"
        }
      ],
      "actor": "Application developer",
      "goal": "Know which instant a wall time in a zone names, or learn that it names none or several.",
      "preconditions": [
        "The application has a rule bundle in the format of conformance/rules/demo-zones.json, as a file or as text.",
        "The application imports CivilDateTime, ZoneRules and TemporalContext from @utv/core."
      ],
      "postconditions": [
        "The application holds an Outcome<Instant>: one instant, both instants of an overlap in ascending order, none for a gap, or the reason the rules can't answer.",
        "Nothing was read from the host's tz database."
      ],
      "flow": [
        {
          "id": "load",
          "actor": "Application developer",
          "action": "Loads the rules with ZoneRules.load(path) (or ZoneRules.parse(text)) and wraps them with TemporalContext.with(rules).",
