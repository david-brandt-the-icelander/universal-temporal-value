      ],
      "criteria": [
        "ZonedIntent.resolve returns the instant for 09:00 in Paris on 1 June 2027; Instant.inZone gives the wall time in New York.",
        "02:30 on 8 March 2026 in New York resolves to none with diagnostic gap, and with Gap.ShiftForward to 03:30 EDT.",
        "01:30 on 1 November 2026 in New York resolves to both instants with diagnostic ambiguous, one of them the one JavaScript picks; Overlap.Earliest returns the first.",
        "TemporalContext.compare returns multiple for 01:30 and 01:45 that night, with ambiguous once per side.",
        "ZonedIntent.addDays keeps noon across the spring-forward night."
      ],
