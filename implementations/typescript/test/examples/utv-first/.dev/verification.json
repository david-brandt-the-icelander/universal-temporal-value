        }
      ],
      "criteria": [
        "Instant.fromUnixMilliseconds takes a clock reading as an input; fromUnixSeconds keeps the epoch, all nine nanosecond digits and a quarter second.",
        "Instant.until returns an exact fraction, and 23 hours across the spring-forward day.",
        "Instant.add moves by exactly the POSIX seconds given, and returns unsupported (needs-leap-seconds) for SI seconds.",
        "Instant.toDate returns the original Date, warns precision-loss for nanoseconds, and is unsupported beyond the range of Date.",
        "Period.days(1) is not 86,400 seconds; Period.months(1) writes P1M.",
        "ElapsedSeconds.of holds ninety minutes, and 86,400 SI seconds is not a calendar day."
      ],
      "checks": [
