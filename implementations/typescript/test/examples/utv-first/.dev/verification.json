    {
      "id": "months-times-date-times",
      "title": "Months, times and date-times",
      "summary": "CivilYearMonth, CivilTime, CivilDateTime and FixedOffsetDateTime, the text form's Z versus +00:00, and refusing a Date's local wall time.",
      "subject": [
        {
          "path": "implementations/typescript/src/.dev/feature.json",
          "entityId": "wall-clock-arithmetic"
        },
        {
          "path": "implementations/typescript/src/.dev/feature.json",
          "entityId": "lossless-text-form"
        }
      ],
      "criteria": [
        "CivilYearMonth.of makes a month without a day; addMonths carries into the next year.",
        "CivilTime.of writes no seconds when none are given, and writes them when they are.",
        "CivilDateTime.of makes a wall-clock date-time; tryOf returns unsupported (leap-second) for 23:59:60; addHours carries into the next day; inZone keeps the wall time and zone; atOffset pins the wall time to the offset.",
        "FixedOffsetDateTime.parse keeps the wall time and offset; toInstant returns the UTC moment.",
        "parse returns an Instant for text ending in Z and a FixedOffsetDateTime for +00:00.",
        "fromDate refuses the intent local with unsupported (local-zone)."
      ],
      "checks": [
