    {
      "id": "intl-date-time-format",
      "title": "Intl.DateTimeFormat",
      "summary": "What Intl.DateTimeFormat does with zones and calendars, compared with Instant.inZone, ZonedIntent and validateSemantic.",
      "subject": [
        {
          "path": "docs/.dev/requirements.json",
          "entityId": "example-scenario-catalog"
        }
      ],
      "criteria": [
        "formatToParts shows 03:00 in New York at 07:00 UTC on 1 June 2027, as Instant.inZone does.",
        "It shows 03:00 for the minute after 01:59 on the spring-forward night, and 01:30 for the later instant of the fall-back wall time, where UTV's resolve reports gap and ambiguous.",
        "Noon plus 86,400,000 ms before the spring-forward night shows 13:00, where ZonedIntent.addDays keeps noon.",
        "format writes 14 Heshvan 5787 for 25 October 2026 in the Hebrew calendar, where validateSemantic answers unsupported."
      ],
      "checks": [
