      "id": "dates",
      "title": "Dates and months, UTV first",
      "summary": "CivilDate and CivilYearMonth for every date scenario of the catalog, against chrono's NaiveDate.",
      "subject": [
        {
          "path": "implementations/rust/src/typed/.dev/feature.json",
          "entityId": "valid-by-construction"
