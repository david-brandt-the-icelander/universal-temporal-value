    {
      "id": "times-and-offsets",
      "title": "Times, date-times and offsets, native first",
      "summary": "NaiveTime, NaiveDateTime, FixedOffset and DateTime parsing and equality, with UTV's civil types as the other side.",
      "subject": [
        {
          "path": "implementations/rust/src/typed/.dev/feature.json",
          "entityId": "text-display"
        },
        {
          "path": "implementations/rust/src/interop/.dev/feature.json",
          "entityId": "intent-named-by-target"
        }
      ],
      "criteria": [
        "NaiveTime's to_string writes seconds that were never given",
        "NaiveTime::overflowing_add_signed wraps past midnight and hands back the lost day; NaiveDateTime::checked_add_signed carries into the next day",
        "FixedOffset::with_ymd_and_hms pins the wall time to the offset",
        "DateTime::parse_from_rfc3339 cannot tell ...Z from ...+00:00",
        "DateTime's == is true after a round trip through UTV, and also when only the offsets differ"
      ],
      "checks": [
        {
          "type": "automated",
          "path": "implementations/rust/tests/native_first/naive_time.rs",
          "symbol": "to_string",
          "command": "cargo test"
