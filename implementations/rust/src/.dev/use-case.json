          "action": "Checks the value against the kind's definition in the embedded structural schema.",
          "sources": [
            {
              "path": "implementations/rust/src/lib.rs",
              "symbol": "validate_shape"
            },
            {
              "path": "implementations/rust/src/lib.rs",
              "symbol": "SchemaCx"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "calendar",
          "actor": "JSON layer",
          "action": "For validate_gregorian_civil: checks the month and the day in that month of a proleptic Gregorian civil value.",
          "sources": [
            {
              "path": "implementations/rust/src/lib.rs",
              "symbol": "check_civil"
            }
