      "id": "read-and-write-text",
      "name": "Read and write the text form",
      "description": "A developer reads a value from text (ISO 8601 / RFC 9557 points, ISO 8601 periods, bracket or EDTF intervals) and writes values back as text (task parse-offsets). The typed entrypoints, utv::parse and Display, call parse_text and format_text.",
      "sources": [
        {
          "path": "implementations/rust/src/text.rs",
          "symbol": "parse_text"
        },
        {
          "path": "implementations/rust/src/text.rs",
          "symbol": "format_text"
        },
        {
          "path": "implementations/rust/src/typed/value.rs",
          "symbol": "parse"
        }
      ],
      "actor": "Application developer",
      "goal": "Turn text into the value it describes and back, without losing or inventing anything.",
      "preconditions": [
        "The developer has text, or a value to print."
      ],
      "postconditions": [
        "The developer holds the value the text describes (a typed Value, or UTV JSON), or an outcome whose code says why the text was refused.",
        "Printed text parses back to the same value."
      ],
      "flow": [
        {
          "id": "parse",
          "actor": "Application developer",
          "action": "Calls utv::parse(text) (or T::parse, or text.parse::<T>()), or utv::parse_text(text) at the JSON layer.",
          "sources": [
            {
              "path": "implementations/rust/src/typed/value.rs",
              "symbol": "parse"
            },
            {
              "path": "implementations/rust/src/text.rs",
