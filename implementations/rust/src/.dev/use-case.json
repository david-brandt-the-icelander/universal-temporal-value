    {
      "id": "validate-utv-json",
      "name": "Validate UTV JSON and read it into typed values",
      "description": "A developer receives UTV JSON from elsewhere, checks that it is well-formed utv/1.0 and, for civil values, a real Gregorian date, and reads it into a typed value where there is one.",
      "sources": [
        {
          "path": "implementations/rust/src/lib.rs",
          "symbol": "validate_structural"
        },
        {
          "path": "implementations/rust/src/lib.rs",
          "symbol": "validate_gregorian_civil"
        },
        {
          "path": "implementations/rust/src/typed/mod.rs",
          "symbol": "from_json"
        }
      ],
      "actor": "Application developer",
      "goal": "Know whether a piece of UTV JSON can be trusted and used, and use it as a Rust value.",
      "preconditions": [
        "The developer has JSON text, or a parsed serde_json::Value, that claims to be UTV."
      ],
      "postconditions": [
        "The developer knows whether the JSON is structurally valid, semantically valid, and held by a typed type, each as a separate answer with its code."
      ],
      "flow": [
        {
          "id": "validate",
          "actor": "Application developer",
          "action": "Calls utv::validate_structural(text), or validate_gregorian_civil(text) for the Gregorian check too.",
          "sources": [
            {
              "path": "implementations/rust/src/lib.rs",
              "symbol": "validate_structural"
            },
            {
              "path": "implementations/rust/src/lib.rs",
              "symbol": "validate_gregorian_civil"
            }
          ],
          "participantKind": "actor",
          "actorDocument": "Actors/application-developer.md"
        },
        {
          "id": "parse",
          "actor": "JSON layer",
          "action": "Parses the text strictly, refusing a repeated key.",
          "sources": [
            {
              "path": "implementations/rust/src/lib.rs",
              "symbol": "parse_for_validation"
            },
            {
              "path": "implementations/rust/src/lib.rs",
              "symbol": "StrictVisitor"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "envelope",
          "actor": "JSON layer",
          "action": "Checks the envelope: schema utv/1.0, a core kind, a value, no unknown top-level property.",
          "sources": [
            {
              "path": "implementations/rust/src/lib.rs",
              "symbol": "check_envelope"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "schema",
