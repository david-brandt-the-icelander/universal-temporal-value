            }
          ],
          "participantKind": "actor",
          "actorDocument": "Actors/application-developer.md"
        },
        {
          "id": "route",
          "actor": "Text form",
          "action": "Chooses the grammar from the first characters: [ or ( an interval, P or -P a period, a / outside brackets an EDTF interval, otherwise a point.",
          "sources": [
            {
              "path": "implementations/rust/src/text.rs",
              "symbol": "parse"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "read-point",
          "actor": "Text form",
          "action": "Reads each point with the ISO 8601 / RFC 9557 grammar: Z or -00:00 an instant, ±hh:mm a fixed offset (+00:00 is an offset of 0), [Area/Location] a zoned intention.",
          "sources": [
            {
              "path": "implementations/rust/src/text.rs",
              "symbol": "point"
