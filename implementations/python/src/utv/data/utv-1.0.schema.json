              "$ref": "#/$defs/rational"
            },
            "components": {
              "type": "object"
            },
            "rules": {
              "$ref": "#/$defs/ruleRef"
            },
            "sequence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "basis"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "schema",
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "intervalValue": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "utv/1.0"
        },
        "kind": {
          "const": "interval"
        },
        "value": {
          "type": "object",
          "properties": {
            "domain": {
