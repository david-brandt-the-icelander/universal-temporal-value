            }
          },
          "required": [
            "domain"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "properties": {
                "construction": {
                  "const": "start-end"
                }
              },
              "required": [
                "start",
                "end",
                "construction"
              ]
            },
            {
              "properties": {
                "construction": {
                  "const": "start-amount"
                }
              },
              "required": [
                "start",
                "amount",
                "construction"
              ]
            },
            {
              "properties": {
                "construction": {
                  "const": "amount-end"
                }
              },
              "required": [
                "amount",
                "end",
                "construction"
              ]
            },
            {
              "not": {
                "required": [
                  "construction"
                ]
              },
              "required": [
                "start",
                "end"
              ]
            }
          ]
        },
        "provenance": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "schema",
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
