            "calendar": {
              "$ref": "#/$defs/calendar"
            },
            "zone": {
              "$ref": "#/$defs/zone"
            },
            "zoneIntent": {
              "enum": [
                "follow-zone-id",
                "follow-location-law",
                "fixed-offset",
                "fixed-instant",
                "floating-wall",
                "historical-assertion"
              ]
            },
            "resolutionPolicy": {
              "type": "object",
              "properties": {
                "gap": {
                  "enum": [
                    "reject",
                    "preserve-unresolved",
                    "shift-forward-by-gap",
                    "shift-backward-by-gap",
                    "next-valid-boundary",
                    "previous-valid-boundary"
                  ]
                },
                "overlap": {
                  "enum": [
                    "reject",
                    "all",
                    "earliest",
                    "latest",
                    "offset-match",
                    "occurrence-index"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "offsetAssertion": {
              "type": "integer"
            },
            "location": {
              "type": "object"
            },
            "quality": {
              "$ref": "#/$defs/quality"
            }
          },
          "required": [
            "form",
            "fields",
            "calendar"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "schema",
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
