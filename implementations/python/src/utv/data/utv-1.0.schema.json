{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:utv:schema:1.0",
  "title": "Universal Temporal Value 1.0 structural schema (not a semantic validator)",
  "description": "Structural JSON Schema for UTV 1.0 values (26 core kinds). Passing this schema means a value is well-formed, not that it is semantically valid or resolvable; registry-driven semantic validation is separately mandatory. See spec/SPECIFICATION.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/instantValue"
    },
    {
      "$ref": "#/$defs/civilValue"
    },
    {
      "$ref": "#/$defs/amountValue"
    },
    {
      "$ref": "#/$defs/intervalValue"
    },
    {
      "$ref": "#/$defs/recurrenceValue"
    },
    {
      "$ref": "#/$defs/uncertainValue"
    },
    {
      "$ref": "#/$defs/setValue"
    },
    {
      "$ref": "#/$defs/clockValue"
    },
    {
      "$ref": "#/$defs/observationValue"
    },
    {
      "$ref": "#/$defs/logical-clockValue"
    },
    {
      "$ref": "#/$defs/relativeValue"
    },
    {
      "$ref": "#/$defs/relationValue"
    },
    {
      "$ref": "#/$defs/assertionValue"
    },
    {
      "$ref": "#/$defs/event-historyValue"
    },
    {
      "$ref": "#/$defs/location-intentValue"
    },
    {
      "$ref": "#/$defs/constraintValue"
    },
    {
      "$ref": "#/$defs/calendar-ruleValue"
    },
    {
      "$ref": "#/$defs/temporal-referenceValue"
    },
    {
      "$ref": "#/$defs/ordinal-positionValue"
    },
    {
      "$ref": "#/$defs/event-relativeValue"
    },
    {
      "$ref": "#/$defs/selectionValue"
    },
    {
      "$ref": "#/$defs/sampleValue"
    },
    {
      "$ref": "#/$defs/seriesValue"
    },
    {
      "$ref": "#/$defs/temporal-graphValue"
    },
    {
      "$ref": "#/$defs/sequenceValue"
    },
    {
      "$ref": "#/$defs/patternValue"
    }
  ],
  "$defs": {
    "integerString": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "nonnegative": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "$ref": "#/$defs/integerString"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "ruleRef": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "system",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "precision": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "uncertainty": {
          "type": "object"
        },
        "accuracy": {
          "type": "object"
        },
        "confidence": {
          "type": "object"
        },
        "correlationGroup": {
          "type": "string"
        },
        "method": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "fields": {
      "type": "object",
      "properties": {
        "year": {
          "$ref": "#/$defs/integerString"
        },
        "eraYear": {
          "$ref": "#/$defs/integerString"
        },
        "month": {
          "type": "integer"
        },
        "day": {
          "type": "integer"
        },
        "hour": {
          "type": "integer"
        },
        "minute": {
          "type": "integer"
        },
        "second": {
          "type": "integer"
        },
        "nano": {
          "type": "integer"
        },
        "week": {
          "type": "integer"
        },
        "weekday": {
          "type": "integer"
        },
        "ordinal": {
          "type": "integer"
        },
        "quarter": {
          "type": "integer"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "calendar": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "chronology": {
          "enum": [
            "proleptic",
            "historical-jurisdiction",
            "registered"
          ]
        },
        "rules": {
          "$ref": "#/$defs/ruleRef"
        },
        "jurisdiction": {
          "type": "string"
        },
        "dayBoundary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "chronology"
      ],
      "additionalProperties": false
    },
    "zone": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "iana"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "integer"
            },
            "rules": {
              "$ref": "#/$defs/ruleRef"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "fixed-offset"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "integer"
            },
            "rules": {
              "$ref": "#/$defs/ruleRef"
            }
          },
          "required": [
            "type",
            "seconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "custom"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "integer"
            },
            "rules": {
              "$ref": "#/$defs/ruleRef"
            }
          },
          "required": [
            "type",
            "rules"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "local-solar"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "integer"
            },
            "rules": {
              "$ref": "#/$defs/ruleRef"
            }
          },
          "required": [
            "type",
            "rules"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "floating",
                "unknown"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "seconds": {
              "type": "integer"
            },
            "rules": {
              "$ref": "#/$defs/ruleRef"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "boundary": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "included",
                "excluded"
              ]
            },
            "point": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "state",
            "point"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "unbounded",
                "unknown"
              ]
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      ]
    },
    "instantValue": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "utv/1.0"
        },
        "kind": {
          "const": "instant"
        },
        "value": {
          "type": "object",
          "properties": {
            "system": {
              "$ref": "#/$defs/ruleRef"
            },
            "ticks": {
              "$ref": "#/$defs/integerString"
            },
            "subTick": {
              "$ref": "#/$defs/rational"
            },
            "coordinate": {
              "$ref": "#/$defs/rational"
            },
            "quality": {
              "$ref": "#/$defs/quality"
            }
          },
          "required": [
            "system"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "ticks"
              ],
              "not": {
                "required": [
                  "coordinate"
                ]
              }
            },
            {
              "required": [
                "coordinate"
              ],
              "not": {
                "required": [
                  "ticks"
                ]
              }
            }
          ]
        },
        "provenance": {
          "type": "object"
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "schema",
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "civilValue": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "utv/1.0"
        },
        "kind": {
          "const": "civil"
        },
        "value": {
          "type": "object",
          "properties": {
            "form": {
              "enum": [
                "date",
                "time",
                "datetime",
                "year",
                "year-month",
                "month-day",
                "week-date",
                "ordinal-date",
                "quarter",
                "season",
