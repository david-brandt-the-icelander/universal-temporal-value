    {
      "id": "instants-and-amounts",
      "title": "Instant, Duration and Period",
      "summary": "java.time's instants and amounts, compared with Instant, PosixSeconds, ElapsedSeconds and Period.",
      "subject": [
        {
          "path": "implementations/java/src/main/java/net/icelander/utv/.dev/feature.json",
          "entityId": "exact-instants-and-seconds"
        }
      ],
      "criteria": [
        "Instant.now survives the trip through UTV; ofEpochSecond gives the epoch and keeps nine digits; getEpochSecond drops the fraction; atZone matches Instant.inZone.",
        "Duration.ofDays(1) equals 86,400 seconds; ofMinutes counts 60 a minute; between is exact; dividedBy(3) truncates to whole nanoseconds.",
        "Period.ofDays is a calendar day; Period.ofMonths writes P1M."
      ],
      "checks": [
        {
          "type": "automated",
