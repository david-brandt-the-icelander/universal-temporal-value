    {
      "id": "offsets-and-zones",
      "title": "OffsetDateTime and ZonedDateTime",
      "summary": "java.time's offset and zoned values, compared with FixedOffsetDateTime, ZonedIntent and TemporalContext.",
      "subject": [
        {
          "path": "implementations/java/src/main/java/net/icelander/utv/.dev/feature.json",
          "entityId": "dst-gap-and-overlap"
        },
        {
          "path": "implementations/java/src/main/java/net/icelander/utv/.dev/feature.json",
          "entityId": "zoned-order-needs-context"
        },
        {
          "path": "implementations/java/src/main/java/net/icelander/utv/.dev/feature.json",
          "entityId": "lossless-text-form"
        }
      ],
      "criteria": [
        "OffsetDateTime.of pins a wall time to an offset; parse cannot tell Z from +00:00; plusDays keeps the offset across DST; a round trip through UTV is equal.",
        "ZonedDateTime.of names the instant once, moves a gap forward silently and picks the earlier instant of an overlap silently; withLaterOffsetAtOverlap matches Overlap.LATEST.",
        "withZoneSameInstant matches Instant.inZone; plusDays keeps noon; plus(Duration of a day) gives 13:00; isBefore answers in an overlap where UTV says multiple.",
        "ZonedDateTime.now with no clock is in the host's default zone."
      ],
      "checks": [
        {
          "type": "automated",
          "path": "implementations/java/src/test/java/net/icelander/utv/examples/nativefirst/time/OffsetDateTimeTest.java",
          "symbol": "OffsetDateTimeTest",
          "command": "mvn -q test"
        },
        {
          "type": "automated",
          "path": "implementations/java/src/test/java/net/icelander/utv/examples/nativefirst/time/ZonedDateTimeTest.java",
          "symbol": "ZonedDateTimeTest",
          "command": "mvn -q test"
        }
      ],
      "details": "ZonedDateTimeTest reads the JDK's tz database (it needs the 2026–2027 rules of New York and Paris), and ZonedDateTimeTest.Now reads the clock and the host's zone on purpose, comparing the zone with ZoneId.systemDefault().",
      "relationships": [
        {
          "relation": "verifies",
