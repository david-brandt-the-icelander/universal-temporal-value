          "path": "implementations/java/src/main/java/net/icelander/utv/.dev/feature.json",
          "entityId": "month-end-none"
        }
      ],
      "criteria": [
        "LocalDate.of creates real days and the years 275760 and −500, and throws for 30 February and month 13; LocalDate.MAX is the last day of year 999,999,999.",
        "LocalDate.parse reads 2026-11-05 and throws for 2026-02-30; a pattern formatter clamps it to the month's last day.",
        "getDayOfWeek is Thursday and numbers Sunday 7; plusDays matches; plusMonths and plus(Period) clamp 31 January to 28 February silently.",
        "until counts 50 days; isBefore matches; Year.isLeap agrees with CivilDate.isLeapYear (parameterized)."
      ],
      "checks": [
        {
          "type": "automated",
