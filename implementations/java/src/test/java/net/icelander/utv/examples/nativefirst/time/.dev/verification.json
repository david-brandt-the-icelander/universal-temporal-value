      "id": "times-and-months",
      "title": "LocalTime, LocalDateTime and YearMonth",
      "summary": "java.time's times, date-times and months, compared with CivilTime, CivilDateTime and CivilYearMonth.",
      "subject": [
        {
          "path": "implementations/java/src/main/java/net/icelander/utv/.dev/feature.json",
          "entityId": "wall-clock-arithmetic"
        }
      ],
      "criteria": [
        "LocalTime.toString drops seconds given as zero; plusHours wraps and loses the day.",
        "LocalDateTime.of has no zone and throws for second 60; plusHours carries; now takes the clock's zone.",
        "YearMonth.of and plusMonths match CivilYearMonth."
      ],
      "checks": [
        {
          "type": "automated",
          "path": "implementations/java/src/test/java/net/icelander/utv/examples/nativefirst/time/LocalTimeTest.java",
