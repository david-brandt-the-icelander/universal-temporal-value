      "id": "local-date",
      "title": "LocalDate and Year",
      "summary": "java.time's dates, compared with CivilDate.",
      "subject": [
        {
          "path": "implementations/java/src/main/java/net/icelander/utv/.dev/feature.json",
          "entityId": "valid-by-construction"
