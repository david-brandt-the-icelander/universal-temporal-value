        },
        {
          "path": "implementations/java/src/main/java/net/icelander/utv/.dev/feature.json",
          "entityId": "explicit-zone-rules"
        }
      ],
      "criteria": [
        "09:00 in Paris resolves to one instant, which is 03:00 in New York.",
        "02:30 on 8 March 2026 in New York is none (gap), and 03:30 daylight time with Gap.SHIFT_FORWARD.",
        "01:30 on 1 November 2026 in New York is multiple (ambiguous), and the earlier instant with Overlap.EARLIEST.",
        "01:30 vs 01:45 that night compares as multiple; 09:00 Paris and 03:00 New York compare equal.",
        "Noon + 1 day keeps noon (ZonedIntent.addDays); ZonedIntent.toZonedDateTime gives back the original ZonedDateTime."
      ],
      "checks": [
