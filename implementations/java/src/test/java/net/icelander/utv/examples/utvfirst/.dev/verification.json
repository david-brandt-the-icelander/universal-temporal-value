      "id": "zones",
      "title": "Zones (ZonedIntent, Instant.inZone, TemporalContext)",
      "summary": "09:00 in Paris, the New York gap and overlap, ordering in an overlap, and noon plus a day across DST, with the pinned demo rules.",
      "subject": [
        {
          "path": "implementations/java/src/main/java/net/icelander/utv/.dev/feature.json",
          "entityId": "dst-gap-and-overlap"
        },
